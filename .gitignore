# Dépendances de l'outillage (Capacitor CLI...) — PAS le node_modules de nodejs-project,
# qui lui doit être commité car il est embarqué tel quel dans l'APK.
/node_modules/

# Sorties de build
/android/app/build/
/android/build/
/android/.gradle/
/android/capacitor-cordova-android-plugins/build/
# Régénérés à chaque build par le workflow CI (voir build-android.yml) — volumineux (~180 Mo
# avec les binaires libnode), inutile de les committer.
/android/app/libs/
*.apk
*.aab

# Secrets — ne jamais committer le keystore de signature
/android/app/fss-release.keystore
*.keystore
*.jks

# Divers
.DS_Store
local.properties
