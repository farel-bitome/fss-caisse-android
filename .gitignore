# Dépendances de l'outillage (Capacitor CLI...) — PAS le node_modules de nodejs-project,
# qui lui doit être commité car il est embarqué tel quel dans l'APK.
/node_modules/

# Sorties de build
/android/app/build/
/android/build/
/android/.gradle/
/android/capacitor-cordova-android-plugins/build/
# Régénérés à chaque build par le workflow CI (voir build-android.yml) — volumineux (~180 Mo
# avec les binaires libnode), inutile de les committer.
/android/app/libs/
*.apk
*.aab

# Secrets — ne jamais committer le keystore de signature RELEASE (Play Store), qui doit rester
# uniquement dans le secret GitHub FSS_KEYSTORE_BASE64 (voir build-android.yml).
/android/app/fss-release.keystore
*.keystore
*.jks
# EXCEPTION volontaire : fss-debug.keystore N'EST PAS un secret sensible (il ne sert qu'aux APK
# de test/sideload, jamais au Play Store) et DOIT au contraire être committé — c'est justement en
# le gardant identique et présent dans le dépôt à chaque build CI qu'une nouvelle APK peut
# s'installer par-dessus l'ancienne sur les TPE sans perdre les données (voir le commentaire dans
# android/app/build.gradle). Sans cette ligne, la règle "*.keystore" ci-dessus l'aurait exclu du
# commit — cause du "Fichier Keystore ... non trouvé" au premier build après son ajout.
!/android/app/fss-debug.keystore

# Divers
.DS_Store
local.properties
