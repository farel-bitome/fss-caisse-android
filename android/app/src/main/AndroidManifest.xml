<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Requis à partir d'Android 11 (API 30) : sans cette déclaration, PackageManager ne peut
         PAS voir si ces services fabricant sont installés (visibilité des paquets restreinte
         par défaut), même quand ils le sont réellement — la détection "universelle" de
         l'imprimante dans PrinterDriverFactory dépend entièrement de ces deux lignes. -->
    <queries>
        <!-- Service d'impression Sunmi (toutes séries : V1, V2/V2 Pro, V3, T1/T2, P1, D2, S2...) -->
        <package android:name="woyou.aidlservice.jiuiv5" />
        <!-- Service d'impression Senraise (H10, H10C, H10S, H10P) -->
        <package android:name="recieptservice.com.recieptservice" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:extractNativeLibs="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <service
            android:name=".FssServerService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Requis pour que le serveur de caisse embarqué (mode autonome) continue de tourner
         écran éteint ou appli en arrière-plan — voir FssServerService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ exige cette permission pour afficher la notification du foreground service. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Permission "spéciale" (accordée manuellement par l'utilisateur, pas au moment de
         l'installation) nécessaire pour que HtmlToBitmap puisse créer sa fenêtre de rendu hors
         écran via TYPE_APPLICATION_OVERLAY même quand l'appli est en arrière-plan ou l'écran
         éteint — le cas du rôle "Serveur" en mode autonome, d'où le bon de commande automatique
         qui pouvait ne jamais sortir sur certains TPE (voir HtmlToBitmap, point 4 de l'historique
         de classe, et FssNativeBridge#requestOverlayPermission). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Permet de proposer à l'utilisateur d'exclure l'appli de l'optimisation de batterie
         (voir FssNativeBridge#requestIgnoreBatteryOptimizations) : réduit le risque que le
         système tue l'activité/la WebView en arrière-plan sur les appareils avec une gestion
         batterie agressive (cause probable des bons de commande automatiques manqués). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
</manifest>
