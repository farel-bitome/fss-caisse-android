# Using Android gitignore template: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
# ATTENTION : le template Android standard met ces motifs SANS "/" en tête ("bin/", "build/"...),
# ce qui les fait correspondre à N'IMPORTE QUEL dossier portant ce nom À N'IMPORTE QUELLE
# PROFONDEUR sous android/ — y compris, en pratique, des dossiers de build internes à certains
# paquets npm embarqués dans app/src/main/assets/www/nodejs-project/node_modules/ (par exemple
# engine.io/build/, engine.io-parser/build/, socket.io-parser/build/). C'est un bug réel et
# vérifié rencontré sur ce projet : ces dossiers étaient exclus SILENCIEUSEMENT par Git (jamais
# poussés sur GitHub, donc jamais présents dans l'APK compilé par CI), provoquant des erreurs
# "Cannot find module" au démarrage du serveur embarqué alors que tout semblait correct en local.
# On ancre donc chaque motif à l'emplacement RÉEL des dossiers de build Gradle qu'il vise.
app/bin/
app/gen/
app/out/
capacitor-cordova-android-plugins/bin/
capacitor-cordova-android-plugins/gen/
capacitor-cordova-android-plugins/out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
app/build/
capacitor-cordova-android-plugins/build/

# Sécurité supplémentaire : quel que soit un futur motif générique non ancré qui serait ajouté
# plus haut (mise à jour de ce template, nouvelle règle...), ne JAMAIS exclure le serveur Node
# embarqué et son node_modules — il est copié tel quel dans l'APK et doit être commité en entier,
# "build/" internes aux paquets npm inclus.
!app/src/main/assets/www/nodejs-project/
!app/src/main/assets/www/nodejs-project/**

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
# Android Studio 3 in .gitignore file.
.idea/caches
.idea/modules.xml
# Comment next line if keeping position of elements in Navigation Editor is relevant for you
.idea/navEditor.xml

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
#*.jks
#*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

# Android Profiling
*.hprof

# Cordova plugins for Capacitor
capacitor-cordova-android-plugins

# Copied web assets
app/src/main/assets/public

# Generated Config files
app/src/main/assets/capacitor.config.json
app/src/main/assets/capacitor.plugins.json
app/src/main/res/xml/config.xml
